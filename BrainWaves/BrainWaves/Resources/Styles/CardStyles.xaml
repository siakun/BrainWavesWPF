<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 관련된 컨트롤을 묶는 면. 그림자 대신 바탕보다 한 단계 밝은 면과 가는 테두리로 구분한다. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
    </Style>

    <!-- 카드 안에서 항목을 나누는 선. 카드 안쪽 여백만큼 들여 쓴다. -->
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="16,0"/>
        <Setter Property="Background" Value="{StaticResource Brush.Line}"/>
    </Style>
</ResourceDictionary>
