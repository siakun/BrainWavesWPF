<!--
앱 전체의 색과 글꼴. 화면과 스타일은 여기 정의한 키만 참조하고 색 값을 직접 적지 않는다.

색은 역할로 나눈다. 바탕과 면, 경계, 글자는 밤에 켜 두는 앱이라 어둡고 채도를 낮게 두고,
채도가 있는 색은 좌우 채널 두 가지에만 쓴다. 바이노럴 비트는 왼쪽과 오른쪽에 서로 다른 소리를 들려주는 것이
전부이므로, 화면 어디에서든 ChannelLeft 색은 왼쪽, ChannelRight 색은 오른쪽을 뜻한다. 뇌파 대역을 색으로
칠하면 이 약속이 흐려지므로 대역은 그리스 문자로 구분한다(Model/BrainwaveBand.cs).
재생 버튼 같은 주 동작은 채널 색이 아니라 가장 밝은 글자 색으로 칠해 채널 표시와 겹치지 않게 한다.

숫자 표시는 계기판처럼 읽히도록 Bahnschrift 가는 굵기를 쓰고, 본문은 Windows 기본 UI 글꼴을 쓴다.
두 글꼴 모두 Windows 10 이상에 들어 있어 앱에 글꼴 파일을 넣지 않는다.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.Background">#0B0E15</Color>
    <Color x:Key="Color.Surface">#121723</Color>
    <Color x:Key="Color.SurfaceRaised">#1A2030</Color>
    <Color x:Key="Color.Line">#232A3B</Color>
    <Color x:Key="Color.Text">#E7EAF2</Color>
    <Color x:Key="Color.TextMuted">#8B94A7</Color>
    <Color x:Key="Color.TextFaint">#5D667A</Color>
    <Color x:Key="Color.ChannelLeft">#5CCFE6</Color>
    <Color x:Key="Color.ChannelRight">#F4A86A</Color>
    <Color x:Key="Color.Danger">#F2777A</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}"/>
    <SolidColorBrush x:Key="Brush.Line" Color="{StaticResource Color.Line}"/>
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}"/>
    <SolidColorBrush x:Key="Brush.TextFaint" Color="{StaticResource Color.TextFaint}"/>
    <SolidColorBrush x:Key="Brush.ChannelLeft" Color="{StaticResource Color.ChannelLeft}"/>
    <SolidColorBrush x:Key="Brush.ChannelRight" Color="{StaticResource Color.ChannelRight}"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>

    <!-- 재생 중인 프리셋처럼 좌우 두 채널이 함께 울리는 상태를 표시할 때 쓴다. -->
    <LinearGradientBrush x:Key="Brush.Stereo" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Color.ChannelLeft}" Offset="0"/>
        <GradientStop Color="{StaticResource Color.ChannelRight}" Offset="1"/>
    </LinearGradientBrush>

    <FontFamily x:Key="Font.Display">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Body">Segoe UI Variable Text, Segoe UI</FontFamily>

</ResourceDictionary>
