<!--
하단 네비게이션 바가 있는 프레임 기반 네비게이션 컨테이너
-->
<Window x:Class="BrainWaves.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BrainWaves.ViewModel"
        xmlns:views="clr-namespace:BrainWaves.View"
        xmlns:behaviors="clr-namespace:BrainWaves.Behaviors"
        mc:Ignorable="d"
        Title="BrainWaves - Binaural Beat Generator"
        Width="450" MinWidth="450"
        SizeToContent="Height"
        behaviors:WindowAutoFit.IsEnabled="True"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <materialDesign:DrawerHost IsLeftDrawerOpen="False">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- App Bar -->
            <materialDesign:ColorZone Grid.Row="0"
                                      Padding="16"
                                      materialDesign:ElevationAssist.Elevation="Dp4"
                                      Mode="PrimaryMid">
                <DockPanel>
                    <materialDesign:PopupBox DockPanel.Dock="Right"
                                             PlacementMode="BottomAndAlignRightEdges">
                        <StackPanel>
                            <Button Content="About" />
                            <Button Content="Help" />
                            <Separator />
                            <Button Content="Exit" Click="ExitApp_Click" />
                        </StackPanel>
                    </materialDesign:PopupBox>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Brain" Width="24" Height="24" VerticalAlignment="Center" />
                        <TextBlock Text="BrainWaves" 
                                   VerticalAlignment="Center" 
                                   Margin="16,0,0,0"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}" />
                    </StackPanel>
                </DockPanel>
            </materialDesign:ColorZone>

            <!-- 디자이너에서는 URI 탐색에 의존하지 않고 페이지 인스턴스를 직접 제공한다. -->
            <Frame Grid.Row="1"
                   Source="{Binding ShowingPageName}"
                   d:Source="{x:Null}"
                   d:Content="{d:DesignInstance Type=views:Waves, IsDesignTimeCreatable=True}"
                   NavigationUIVisibility="Hidden"/>

            <!-- Bottom Navigation -->
            <materialDesign:Card Grid.Row="2"
                                 UniformCornerRadius="0"
                                 Padding="0"
                                 materialDesign:ElevationAssist.Elevation="Dp8"
                                 Background="#1A1A2E">
                <Grid Height="80">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <RadioButton x:Name="WavesNav"
                                 Grid.Column="0"
                                 Style="{StaticResource MaterialDesignTabRadioButton}"
                                 Command="{Binding NavigateFrameCommand}"
                                 CommandParameter="pack://application:,,,/View/Waves.xaml"
                                 IsChecked="True"
                                 Height="80">
                        <StackPanel>
                            <materialDesign:PackIcon Kind="Waveform" 
                                                     Width="24" 
                                                     Height="24"
                                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="Waves" 
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"
                                       FontSize="12"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="PresetsNav"
                                 Grid.Column="1"
                                 Style="{StaticResource MaterialDesignTabRadioButton}"
                                 Command="{Binding NavigateFrameCommand}"
                                 CommandParameter="pack://application:,,,/View/Presets.xaml"
                                 Height="80">
                        <StackPanel>
                            <materialDesign:PackIcon Kind="PlaylistPlay" 
                                                     Width="24" 
                                                     Height="24"
                                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="Presets" 
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"
                                       FontSize="12"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="SettingsNav"
                                 Grid.Column="2"
                                 Style="{StaticResource MaterialDesignTabRadioButton}"
                                 Command="{Binding NavigateFrameCommand}"
                                 CommandParameter="pack://application:,,,/View/Settings.xaml"
                                 Height="80">
                        <StackPanel>
                            <materialDesign:PackIcon Kind="Settings" 
                                                     Width="24" 
                                                     Height="24"
                                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="Settings" 
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"
                                       FontSize="12"/>
                        </StackPanel>
                    </RadioButton>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </materialDesign:DrawerHost>
</Window>