<!--
설정 페이지. 업데이트, 앱 소개, 오픈소스 목록을 차례로 놓는다.
업데이트 상태와 조작은 앱 전체가 공유하는 UpdatesViewModel에 있어, 버전을 받는 중에 다른 화면으로 옮겼다 돌아와도 그대로 보인다.
오픈소스 목록은 패키지 수만큼 길어지므로 창 높이를 이 페이지에 맞추지 않는다.
-->
<Page x:Class="BrainWaves.View.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:BrainWaves.ViewModel"
      xmlns:behaviors="clr-namespace:BrainWaves.Behaviors"
      mc:Ignorable="d"
      d:DesignHeight="1100" d:DesignWidth="450"
      behaviors:WindowAutoFit.FitsContent="False"
      Title="Settings">
    <Page.DataContext>
        <vm:SettingsViewModel/>
    </Page.DataContext>

    <Page.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource SlideIn}"/>
        </EventTrigger>
    </Page.Triggers>

    <Page.RenderTransform>
        <TranslateTransform/>
    </Page.RenderTransform>

    <Page.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="Margin" Value="4,28,0,8"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource Brush.Background}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,20,16,24">
                <TextBlock Style="{StaticResource Text.PageTitle}" Margin="4,0,0,0" Text="Settings"/>

                <!-- 업데이트 -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="UPDATES"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="16,14,16,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Title}" Text="BrainWaves"/>
                                    <TextBlock Style="{StaticResource Text.Readout}"
                                               FontSize="14"
                                               FontWeight="Normal"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.TextMuted}"
                                               Text="{Binding Updates.CurrentVersion}"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Text.Status}"
                                           Margin="0,4,0,0"
                                           Text="{Binding Updates.StatusText}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource Button.Secondary}"
                                    VerticalAlignment="Top"
                                    Content="Check now"
                                    Command="{Binding Updates.CheckForUpdatesCommand}"/>
                        </Grid>

                        <Border Style="{StaticResource Divider}"/>

                        <Grid Margin="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource Text.Title}" Text="Automatic updates"/>
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,3,0,0"
                                           Text="Download new versions in the background and install them when you close BrainWaves."/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          Style="{StaticResource Toggle.Switch}"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding Updates.AutoUpdateEnabled}"
                                          AutomationProperties.Name="Automatic updates"/>
                        </Grid>

                        <Border Style="{StaticResource Divider}"/>

                        <Grid Margin="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource Text.Title}" Text="Beta versions"/>
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,3,0,0"
                                           Text="Include pre-release versions in updates and in the version list."/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          Style="{StaticResource Toggle.Switch}"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding Updates.PrereleaseEnabled}"
                                          AutomationProperties.Name="Beta versions"/>
                        </Grid>

                        <Border Style="{StaticResource Divider}"/>

                        <StackPanel Margin="16,12,16,16">
                            <TextBlock Style="{StaticResource Text.Title}" Text="Install another version"/>
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,3,0,0"
                                       Text="Picking any version other than the newest one turns off automatic updates."/>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          Style="{StaticResource ComboBox.Outlined}"
                                          ItemsSource="{Binding Updates.Versions}"
                                          SelectedItem="{Binding Updates.SelectedVersion}"
                                          IsEnabled="{Binding Updates.CanPickVersion}"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Version">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:VersionOption}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="{StaticResource Font.Display}"
                                                           Typography.NumeralAlignment="Tabular"
                                                           Text="{Binding Version}"/>
                                                <TextBlock Margin="8,0,0,0"
                                                           Foreground="{StaticResource Brush.TextMuted}"
                                                           Text="{Binding Tag}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1"
                                        Style="{StaticResource Button.Secondary}"
                                        Margin="12,0,0,0"
                                        Content="Install"
                                        Command="{Binding Updates.InstallSelectedVersionCommand}"/>
                            </Grid>

                            <TextBlock Style="{StaticResource Text.Status}"
                                       Margin="0,8,0,0"
                                       Text="{Binding Updates.VersionsHint}"/>

                            <StackPanel Margin="0,14,0,0"
                                        Visibility="{Binding Updates.IsInstalling, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <TextBlock Style="{StaticResource Text.Caption}"
                                               Text="{Binding Updates.InstallingVersion, StringFormat='Downloading version {0}'}"/>
                                    <TextBlock Style="{StaticResource Text.Readout}"
                                               HorizontalAlignment="Right"
                                               FontSize="13"
                                               FontWeight="Normal"
                                               Text="{Binding Updates.InstallProgress, StringFormat='{}{0}%'}"/>
                                </Grid>
                                <ProgressBar Style="{StaticResource ProgressBar.Line}"
                                             Margin="0,8,0,0"
                                             Maximum="100"
                                             Value="{Binding Updates.InstallProgress, Mode=OneWay}"/>
                                <Grid Margin="0,10,0,0">
                                    <TextBlock Style="{StaticResource Text.Status}"
                                               VerticalAlignment="Center"
                                               Text="{Binding Updates.DownloadSize}"/>
                                    <Button Style="{StaticResource Button.Secondary}"
                                            HorizontalAlignment="Right"
                                            Content="Cancel"
                                            Command="{Binding Updates.CancelInstallCommand}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 소개 -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="ABOUT"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Body}"
                                   Margin="16,14,16,4"
                                   LineHeight="20"
                                   Text="BrainWaves plays a slightly different tone in each ear. Your brain hears the difference between them as a slow pulse, the binaural beat."/>
                        <TextBlock Style="{StaticResource Text.Caption}"
                                   Margin="16,0,16,14"
                                   Text="Use stereo headphones. Speakers mix the two tones before they reach your ears."/>

                        <Border Style="{StaticResource Divider}"/>

                        <Button Style="{StaticResource Button.Row}"
                                Margin="4,4,4,0"
                                Command="{Binding OpenLinkCommand}"
                                CommandParameter="{Binding RepositoryUrl}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Github" Width="20" Height="20"
                                                         Margin="0,0,12,0" VerticalAlignment="Center"
                                                         Foreground="{StaticResource Brush.TextMuted}"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Title}"
                                           FontWeight="Normal" VerticalAlignment="Center"
                                           Text="Source code on GitHub"/>
                                <materialDesign:PackIcon Grid.Column="2" Kind="OpenInNew" Width="16" Height="16"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource Brush.TextFaint}"/>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource Button.Row}"
                                Margin="4,0,4,4"
                                Command="{Binding OpenLinkCommand}"
                                CommandParameter="{Binding IssuesUrl}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="BugOutline" Width="20" Height="20"
                                                         Margin="0,0,12,0" VerticalAlignment="Center"
                                                         Foreground="{StaticResource Brush.TextMuted}"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Title}"
                                           FontWeight="Normal" VerticalAlignment="Center"
                                           Text="Report a problem"/>
                                <materialDesign:PackIcon Grid.Column="2" Kind="OpenInNew" Width="16" Height="16"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource Brush.TextFaint}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 오픈소스 -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="OPEN SOURCE"/>
                <Border Style="{StaticResource Card}" Padding="4">
                    <ItemsControl ItemsSource="{Binding Libraries}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:OpenSourceLibrary}">
                                <Button Style="{StaticResource Button.Row}"
                                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding Url}"
                                        AutomationProperties.Name="{Binding Name}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Text.Title}"
                                                   FontWeight="Normal"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Name}"/>
                                        <TextBlock Grid.Column="1"
                                                   Style="{StaticResource Text.Label}"
                                                   Margin="12,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding License}"/>
                                        <materialDesign:PackIcon Grid.Column="2" Kind="OpenInNew" Width="16" Height="16"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{StaticResource Brush.TextFaint}"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
