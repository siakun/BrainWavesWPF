<!--
설정 페이지. 일반(언어, 트레이), 업데이트, 앱 소개, 오픈소스 목록을 차례로 놓는다.
업데이트 상태와 조작은 앱 전체가 공유하는 UpdatesViewModel에 있어, 버전을 받는 중에 다른 화면으로 옮겼다 돌아와도 그대로 보인다.
오픈소스 목록은 패키지 수만큼 길어지므로 창 높이를 이 페이지에 맞추지 않는다.
-->
<Page x:Class="BrainWaves.View.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:BrainWaves.ViewModel"
      xmlns:behaviors="clr-namespace:BrainWaves.Behaviors"
      xmlns:loc="clr-namespace:BrainWaves.Localization"
      mc:Ignorable="d"
      d:DesignHeight="1100" d:DesignWidth="450"
      behaviors:WindowAutoFit.FitsContent="False"
      Title="Settings">
    <Page.DataContext>
        <vm:SettingsViewModel/>
    </Page.DataContext>

    <Page.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource SlideIn}"/>
        </EventTrigger>
    </Page.Triggers>

    <Page.RenderTransform>
        <TranslateTransform/>
    </Page.RenderTransform>

    <Page.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="Margin" Value="4,28,0,8"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource Brush.Background}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,20,16,24">
                <TextBlock Style="{StaticResource Text.PageTitle}" Margin="4,0,0,0" Text="{loc:Text Settings.Title}"/>

                <!-- 일반 -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="{loc:Text Settings.General}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <!-- 언어. 고르는 즉시 모든 화면의 글자가 바뀐다. -->
                        <Grid Margin="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Text.Title}"
                                       VerticalAlignment="Center"
                                       Text="{loc:Text Settings.Language}"/>
                            <ComboBox Grid.Column="1"
                                      Style="{StaticResource ComboBox.Outlined}"
                                      MinWidth="160"
                                      ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding SelectedLanguage}"
                                      AutomationProperties.Name="{loc:Text Settings.Language}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type loc:LanguageOption}">
                                        <TextBlock Text="{loc:Text Source={Binding Name}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource Divider}"/>

                        <Grid Margin="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource Text.Title}" Text="{loc:Text Settings.Tray}"/>
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,3,0,0"
                                           Text="{loc:Text Settings.Tray.Caption}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          Style="{StaticResource Toggle.Switch}"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding CloseToTray}"
                                          AutomationProperties.Name="{loc:Text Settings.Tray}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 업데이트 -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="{loc:Text Settings.Updates}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="16,14,16,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                <!--
                                글꼴이 다른 이름과 버전을 한 TextBlock의 Run으로 이어 기준선을 맞춘다.
                                TextBlock 둘을 나란히 두면 Bahnschrift의 기준선이 Segoe UI보다 줄 위쪽에 있어 숫자가 떠 보인다.
                                Run에는 여백을 줄 수 없어 간격은 글자 크기의 절반인 en space로 둔다.
                                -->
                                <TextBlock Style="{StaticResource Text.Title}">
                                    <Run Text="BrainWaves"/><Run Text="&#x2002;"/><Run FontFamily="{StaticResource Font.Display}"
                                         FontWeight="Normal"
                                         Typography.NumeralAlignment="Tabular"
                                         Foreground="{StaticResource Brush.TextMuted}"
                                         Text="{Binding Updates.CurrentVersion, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Text.Status}"
                                           Margin="0,4,0,0"
                                           Text="{loc:Text Source={Binding Updates.StatusText}}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource Button.Secondary}"
                                    VerticalAlignment="Center"
                                    Content="{loc:Text Settings.CheckNow}"
                                    Command="{Binding Updates.CheckForUpdatesCommand}"/>
                        </Grid>

                        <Border Style="{StaticResource Divider}"/>

                        <Grid Margin="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource Text.Title}" Text="{loc:Text Settings.AutoUpdate}"/>
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,3,0,0"
                                           Text="{loc:Text Settings.AutoUpdate.Caption}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          Style="{StaticResource Toggle.Switch}"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding Updates.AutoUpdateEnabled}"
                                          AutomationProperties.Name="{loc:Text Settings.AutoUpdate}"/>
                        </Grid>

                        <Border Style="{StaticResource Divider}"/>

                        <Grid Margin="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource Text.Title}" Text="{loc:Text Settings.Beta}"/>
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,3,0,0"
                                           Text="{loc:Text Settings.Beta.Caption}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          Style="{StaticResource Toggle.Switch}"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding Updates.PrereleaseEnabled}"
                                          AutomationProperties.Name="{loc:Text Settings.Beta}"/>
                        </Grid>

                        <Border Style="{StaticResource Divider}"/>

                        <StackPanel Margin="16,12,16,16">
                            <TextBlock Style="{StaticResource Text.Title}" Text="{loc:Text Settings.OtherVersion}"/>
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,3,0,0"
                                       Text="{loc:Text Settings.OtherVersion.Caption}"/>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          Style="{StaticResource ComboBox.Outlined}"
                                          ItemsSource="{Binding Updates.Versions}"
                                          SelectedItem="{Binding Updates.SelectedVersion}"
                                          IsEnabled="{Binding Updates.CanPickVersion}"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="{loc:Text Settings.Version}">
                                    <ComboBox.ItemTemplate>
                                        <!-- 위 버전 표시와 같은 이유로 버전과 꼬리표를 한 TextBlock의 Run으로 잇는다. -->
                                        <DataTemplate DataType="{x:Type vm:VersionOption}">
                                            <TextBlock>
                                                <Run FontFamily="{StaticResource Font.Display}"
                                                     Typography.NumeralAlignment="Tabular"
                                                     Text="{Binding Version, Mode=OneWay}"/><Run Text="&#x2002;"/><Run Foreground="{StaticResource Brush.TextMuted}"
                                                     Text="{loc:Text Source={Binding Tag}}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1"
                                        Style="{StaticResource Button.Secondary}"
                                        Margin="12,0,0,0"
                                        Content="{loc:Text Settings.Install}"
                                        Command="{Binding Updates.InstallSelectedVersionCommand}"/>
                            </Grid>

                            <TextBlock Style="{StaticResource Text.Status}"
                                       Margin="0,8,0,0"
                                       Text="{loc:Text Source={Binding Updates.VersionsHint}}"/>

                            <StackPanel Margin="0,14,0,0"
                                        Visibility="{Binding Updates.IsInstalling, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <TextBlock Style="{StaticResource Text.Caption}"
                                               Text="{loc:Text Updates.DownloadingVersion, Arg={Binding Updates.InstallingVersion}}"/>
                                    <TextBlock Style="{StaticResource Text.Readout}"
                                               HorizontalAlignment="Right"
                                               FontSize="13"
                                               FontWeight="Normal"
                                               Text="{Binding Updates.InstallProgress, StringFormat='{}{0}%'}"/>
                                </Grid>
                                <ProgressBar Style="{StaticResource ProgressBar.Line}"
                                             Margin="0,8,0,0"
                                             Maximum="100"
                                             Value="{Binding Updates.InstallProgress, Mode=OneWay}"/>
                                <Grid Margin="0,10,0,0">
                                    <TextBlock Style="{StaticResource Text.Status}"
                                               VerticalAlignment="Center"
                                               Text="{Binding Updates.DownloadSize}"/>
                                    <Button Style="{StaticResource Button.Secondary}"
                                            HorizontalAlignment="Right"
                                            Content="{loc:Text Settings.Cancel}"
                                            Command="{Binding Updates.CancelInstallCommand}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 소개 -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="{loc:Text Settings.About}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Body}"
                                   Margin="16,14,16,4"
                                   LineHeight="20"
                                   Text="{loc:Text About.Body}"/>
                        <TextBlock Style="{StaticResource Text.Caption}"
                                   Margin="16,0,16,14"
                                   Text="{loc:Text About.Headphones}"/>

                        <Border Style="{StaticResource Divider}"/>

                        <Button Style="{StaticResource Button.Row}"
                                Margin="4,4,4,0"
                                Command="{Binding OpenLinkCommand}"
                                CommandParameter="{Binding RepositoryUrl}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Github" Width="20" Height="20"
                                                         Margin="0,0,12,0" VerticalAlignment="Center"
                                                         Foreground="{StaticResource Brush.TextMuted}"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Title}"
                                           FontWeight="Normal" VerticalAlignment="Center"
                                           Text="{loc:Text About.Source}"/>
                                <materialDesign:PackIcon Grid.Column="2" Kind="OpenInNew" Width="16" Height="16"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource Brush.TextFaint}"/>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource Button.Row}"
                                Margin="4,0,4,4"
                                Command="{Binding OpenLinkCommand}"
                                CommandParameter="{Binding IssuesUrl}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="BugOutline" Width="20" Height="20"
                                                         Margin="0,0,12,0" VerticalAlignment="Center"
                                                         Foreground="{StaticResource Brush.TextMuted}"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Title}"
                                           FontWeight="Normal" VerticalAlignment="Center"
                                           Text="{loc:Text About.Report}"/>
                                <materialDesign:PackIcon Grid.Column="2" Kind="OpenInNew" Width="16" Height="16"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource Brush.TextFaint}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 오픈소스 -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="{loc:Text Settings.OpenSource}"/>
                <Border Style="{StaticResource Card}" Padding="4">
                    <ItemsControl ItemsSource="{Binding Libraries}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:OpenSourceLibrary}">
                                <Button Style="{StaticResource Button.Row}"
                                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding Url}"
                                        AutomationProperties.Name="{Binding Name}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Text.Title}"
                                                   FontWeight="Normal"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Name}"/>
                                        <TextBlock Grid.Column="1"
                                                   Style="{StaticResource Text.Label}"
                                                   Margin="12,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding License}"/>
                                        <materialDesign:PackIcon Grid.Column="2" Kind="OpenInNew" Width="16" Height="16"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{StaticResource Brush.TextFaint}"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
