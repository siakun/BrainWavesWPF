<!--
설정 페이지. 앱 소개와 오픈소스 목록을 차례로 놓는다.
오픈소스 목록은 패키지 수만큼 길어지므로 창 높이를 이 페이지에 맞추지 않는다.
-->
<Page x:Class="BrainWaves.View.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:BrainWaves.ViewModel"
      xmlns:behaviors="clr-namespace:BrainWaves.Behaviors"
      mc:Ignorable="d"
      d:DesignHeight="1100" d:DesignWidth="450"
      behaviors:WindowAutoFit.FitsContent="False"
      Title="Settings">
    <Page.DataContext>
        <vm:SettingsViewModel/>
    </Page.DataContext>

    <Page.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource SlideIn}"/>
        </EventTrigger>
    </Page.Triggers>

    <Page.RenderTransform>
        <TranslateTransform/>
    </Page.RenderTransform>

    <Page.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="Margin" Value="4,28,0,8"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource Brush.Background}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,20,16,24">
                <TextBlock Style="{StaticResource Text.PageTitle}" Margin="4,0,0,0" Text="Settings"/>

                <!-- 소개 -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="ABOUT"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="16,14,16,0">
                            <TextBlock Style="{StaticResource Text.Title}" Text="BrainWaves"/>
                            <TextBlock Style="{StaticResource Text.Readout}"
                                       FontSize="14"
                                       FontWeight="Normal"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.TextMuted}"
                                       Text="{Binding Version}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Body}"
                                   Margin="16,8,16,4"
                                   LineHeight="20"
                                   Text="BrainWaves plays a slightly different tone in each ear. Your brain hears the difference between them as a slow pulse, the binaural beat."/>
                        <TextBlock Style="{StaticResource Text.Caption}"
                                   Margin="16,0,16,14"
                                   Text="Use stereo headphones. Speakers mix the two tones before they reach your ears."/>

                        <Border Style="{StaticResource Divider}"/>

                        <Button Style="{StaticResource Button.Row}"
                                Margin="4,4,4,0"
                                Command="{Binding OpenLinkCommand}"
                                CommandParameter="{Binding RepositoryUrl}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Github" Width="20" Height="20"
                                                         Margin="0,0,12,0" VerticalAlignment="Center"
                                                         Foreground="{StaticResource Brush.TextMuted}"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Title}"
                                           FontWeight="Normal" VerticalAlignment="Center"
                                           Text="Source code on GitHub"/>
                                <materialDesign:PackIcon Grid.Column="2" Kind="OpenInNew" Width="16" Height="16"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource Brush.TextFaint}"/>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource Button.Row}"
                                Margin="4,0,4,4"
                                Command="{Binding OpenLinkCommand}"
                                CommandParameter="{Binding IssuesUrl}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="BugOutline" Width="20" Height="20"
                                                         Margin="0,0,12,0" VerticalAlignment="Center"
                                                         Foreground="{StaticResource Brush.TextMuted}"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Title}"
                                           FontWeight="Normal" VerticalAlignment="Center"
                                           Text="Report a problem"/>
                                <materialDesign:PackIcon Grid.Column="2" Kind="OpenInNew" Width="16" Height="16"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource Brush.TextFaint}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 오픈소스 -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="OPEN SOURCE"/>
                <Border Style="{StaticResource Card}" Padding="4">
                    <ItemsControl ItemsSource="{Binding Libraries}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:OpenSourceLibrary}">
                                <Button Style="{StaticResource Button.Row}"
                                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding Url}"
                                        AutomationProperties.Name="{Binding Name}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Text.Title}"
                                                   FontWeight="Normal"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Name}"/>
                                        <TextBlock Grid.Column="1"
                                                   Style="{StaticResource Text.Label}"
                                                   Margin="12,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding License}"/>
                                        <materialDesign:PackIcon Grid.Column="2" Kind="OpenInNew" Width="16" Height="16"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{StaticResource Brush.TextFaint}"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
