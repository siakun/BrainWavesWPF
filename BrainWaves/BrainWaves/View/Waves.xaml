<!--
수동 주파수 제어 페이지
-->
<Page x:Class="BrainWaves.View.Waves"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:BrainWaves.ViewModel"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="400" 
      Title="Waves">
    <Page.DataContext>
        <vm:WavesViewModel/>
    </Page.DataContext>

    <Page.Resources>
        <!--
        헤더 파형이 흐르는 방식.
        파형은 한 주기짜리 타일을 반복해 채우고, 재생 중에는 그 타일 브러시를 한 주기만큼
        왼쪽으로 미는 동작을 되풀이한다. 타일이 끝없이 이어지므로 창을 넓혀도 오른쪽이 비지 않고,
        한 주기를 다 민 자리는 출발한 자리와 모양이 같아 이음매가 드러나지 않는다.
        멈출 때는 남은 주기를 마저 밀어 세운다. 그래야 멈추는 순간 파형이 제자리로 튀지 않고,
        다시 재생할 때도 이어서 흐르는 것처럼 보인다.
        브러시는 Rectangle이 아니라 Style의 Setter에 둔다. 재생 중에 이 페이지가 새로 만들어지면
        Style을 붙이는 순간 DataTrigger가 곧바로 발동하는데, 요소에 직접 적은 Fill은 Style 특성보다
        나중에 설정되므로 그 시점에는 아직 없다. 애니메이션이 브러시를 찾지 못해 예외가 난다.
        Setter로 심은 값은 트리거가 도는 시점에 이미 자리를 잡고 있고, 요소마다 별개의 인스턴스로
        만들어지므로 스타일을 나눠 써도 서로 간섭하지 않는다.
        -->
        <Style x:Key="BackWaveStyle" TargetType="Rectangle">
            <Setter Property="Fill">
                <Setter.Value>
                    <DrawingBrush TileMode="Tile" Stretch="Fill"
                                  Viewbox="0,0,400,80" ViewboxUnits="Absolute"
                                  Viewport="0,0,400,80" ViewportUnits="Absolute">
                        <DrawingBrush.Transform>
                            <TranslateTransform/>
                        </DrawingBrush.Transform>
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="#1A6C63FF"
                                             Geometry="M0,46 C133,12 267,80 400,46 L400,80 L0,80 Z"/>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(Shape.Fill).(Brush.Transform).(TranslateTransform.X)"
                                                 From="0" To="-400" Duration="0:0:9"
                                                 RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(Shape.Fill).(Brush.Transform).(TranslateTransform.X)"
                                                 To="-400" Duration="0:0:1.2">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 앞쪽 겹은 뒤쪽보다 빠르다. 두 겹이 어긋나며 겹치는 자리가 계속 바뀌어 물결이 이는 것처럼 보인다. -->
        <Style x:Key="FrontWaveStyle" TargetType="Rectangle">
            <Setter Property="Fill">
                <Setter.Value>
                    <DrawingBrush TileMode="Tile" Stretch="Fill"
                                  Viewbox="0,0,300,80" ViewboxUnits="Absolute"
                                  Viewport="0,0,300,80" ViewportUnits="Absolute">
                        <DrawingBrush.Transform>
                            <TranslateTransform/>
                        </DrawingBrush.Transform>
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="#1AFFFFFF"
                                             Geometry="M0,40 C100,0 200,80 300,40 L300,80 L0,80 Z"/>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(Shape.Fill).(Brush.Transform).(TranslateTransform.X)"
                                                 From="0" To="-300" Duration="0:0:5"
                                                 RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(Shape.Fill).(Brush.Transform).(TranslateTransform.X)"
                                                 To="-300" Duration="0:0:1.2">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Page.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource SlideIn}"/>
        </EventTrigger>
    </Page.Triggers>

    <Page.RenderTransform>
        <TranslateTransform/>
    </Page.RenderTransform>

    <Grid Background="#0E0E1A">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 헤더 섹션 -->
                <Grid Grid.Row="0" Height="140">
                    <Grid.Background>
                        <SolidColorBrush Color="#0E0E1A"/>
                    </Grid.Background>

                    <!--
                    웨이브 패턴 오버레이. 주기가 다른 두 겹을 서로 다른 속도로 흘려보낸다.
                    모양, 색, 주기, 속도는 모두 위쪽 스타일에 있다. 여기서는 자리와 높이만 정한다.
                    -->
                    <Rectangle Height="80"
                               VerticalAlignment="Bottom"
                               Style="{StaticResource BackWaveStyle}"/>

                    <Rectangle Height="80"
                               VerticalAlignment="Bottom"
                               Style="{StaticResource FrontWaveStyle}"/>

                    <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                        <!-- 메인 주파수 표시 -->
                        <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0">
                            <TextBlock Text="{Binding Resonance, StringFormat='{}{0:F2}'}"
                                   Foreground="White"
                                   FontWeight="Light"
                                   FontSize="56"
                                   VerticalAlignment="Bottom">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="ResonancePulse">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0.7" To="1" Duration="0:0:1"
                                                                         RepeatBehavior="Forever"
                                                                         AutoReverse="True"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <!-- 멈추지 않으면 재생을 멈춘 뒤에도 숫자가 계속 깜빡인다. -->
                                                    <StopStoryboard BeginStoryboardName="ResonancePulse"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Hz" 
                                   FontSize="36"
                                   Foreground="White"
                                   FontWeight="Light"
                                   VerticalAlignment="Bottom"
                                   Margin="8,0,0,12"/>
                        </StackPanel>

                        <!-- 웨이브 타입 및 설명 -->
                        <Grid HorizontalAlignment="Center"
                          Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                Background="#6C63FF"
                                CornerRadius="20"
                                Padding="16,8">
                                <TextBlock Text="{Binding WaveType}"
                                       Foreground="White"
                                       FontWeight="Medium"
                                       FontSize="12"/>
                            </Border>

                            <materialDesign:PackIcon Grid.Column="1"
                                                 Kind="CircleSmall"
                                                 Width="8"
                                                 Height="8"
                                                 Foreground="White"
                                                 VerticalAlignment="Center"
                                                 Opacity="0.5"/>

                            <Border Grid.Column="2"
                                Background="#6C63FF"
                                CornerRadius="20"
                                Padding="16,8">
                                <TextBlock Text="{Binding WaveDescription}"
                                       Foreground="White"
                                       FontWeight="Medium"
                                       FontSize="12"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- 웨이브 컨트롤 섹션 -->
                <StackPanel Grid.Row="1" Margin="12,8">
                    <!-- Master Volume 컨트롤 -->
                    <Border Margin="8,0,8,8"
                        CornerRadius="20"
                        Background="#1A1A2E">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Grid.Column="0"
                                                     Kind="Speaker"
                                                     Width="20"
                                                     Height="20"
                                                     Foreground="#6C63FF"
                                                     Opacity="0.8"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0"/>

                                <TextBlock Grid.Column="1"
                                       Text="MASTER VOLUME" 
                                       Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                       FontWeight="Medium"
                                       Foreground="#E0E0E0"
                                       VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Grid.Column="0" 
                                                     Kind="VolumeHigh" 
                                                     VerticalAlignment="Center"
                                                     Foreground="#E0E0E0"
                                                     Opacity="0.8"
                                                     Margin="0,0,16,0"/>

                                <Slider Grid.Column="1" 
                                    Value="{Binding MasterVolume, Mode=TwoWay}" 
                                    Maximum="100"
                                    VerticalAlignment="Center"
                                    Foreground="#6C63FF"/>

                                <TextBlock Grid.Column="2" 
                                       Text="{Binding MasterVolume, StringFormat='{}{0:F0}%'}" 
                                       Style="{StaticResource MaterialDesignBody2TextBlock}"
                                       VerticalAlignment="Center"
                                       MinWidth="40"
                                       TextAlignment="Right"
                                       Foreground="#E0E0E0"
                                       Margin="16,0,0,0"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Left Wave 컨트롤 -->
                    <Border Margin="8,0,8,8"
                        CornerRadius="20"
                        Background="#1A1A2E">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Grid.Column="0"
                                                     Kind="HeadphonesSettings"
                                                     Width="20"
                                                     Height="20"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                     Opacity="0.6"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0"/>

                                <TextBlock Grid.Column="1"
                                       Text="LEFT CHANNEL" 
                                       Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                       FontWeight="Medium"
                                       Foreground="#E0E0E0"
                                       VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" 
                                    Command="{Binding DecreaseLeftFrequencyCommand}"
                                    ToolTip="Decrease frequency"
                                    Width="32"
                                    Height="32"
                                    Margin="8"
                                    Background="Transparent"
                                    BorderBrush="#6C63FF"
                                    BorderThickness="2"
                                    materialDesign:ButtonAssist.CornerRadius="18">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="18">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <materialDesign:PackIcon Kind="Minus" Width="20" Height="20" Foreground="White"/>
                                </Button>

                                <Border Grid.Column="1" 
                                    CornerRadius="12"
                                    Padding="24,12"
                                    Margin="8"
                                    Background="#6C63FF">
                                    <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding LeftFrequency, StringFormat='{}{0:F2}'}" 
                                               Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                                               HorizontalAlignment="Center"
                                               Foreground="White"
                                               FontWeight="Medium"/>
                                        <TextBlock Text="Hz" 
                                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                               HorizontalAlignment="Center"
                                               Foreground="White"
                                               Opacity="0.8"/>
                                    </StackPanel>
                                </Border>

                                <Button Grid.Column="2" 
                                    Command="{Binding IncreaseLeftFrequencyCommand}"
                                    ToolTip="Increase frequency"
                                    Width="32"
                                    Height="32"
                                    Margin="8"
                                    Background="Transparent"
                                    BorderBrush="#6C63FF"
                                    BorderThickness="2"
                                    materialDesign:ButtonAssist.CornerRadius="18">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="18">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" Foreground="White"/>
                                </Button>
                            </Grid>

                            <Slider Grid.Row="2"
                                Value="{Binding LeftFrequency, Mode=TwoWay}" 
                                Minimum="20"
                                Maximum="500"
                                TickFrequency="10"
                                IsSnapToTickEnabled="True"
                                TickPlacement="None"
                                Margin="0,0,0,8"
                                Foreground="#6C63FF"
                                materialDesign:SliderAssist.OnlyShowFocusVisualWhileDragging="True"/>

                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Grid.Column="0" 
                                                     Kind="VolumeHigh" 
                                                     VerticalAlignment="Center"
                                                     Foreground="#E0E0E0"
                                                     Opacity="0.8"
                                                     Margin="0,0,16,0"/>

                                <Slider Grid.Column="1" 
                                    Value="{Binding LeftGain, Mode=TwoWay}" 
                                    Maximum="100"
                                    VerticalAlignment="Center"
                                    Foreground="#6C63FF"/>

                                <TextBlock Grid.Column="2" 
                                       Text="{Binding LeftGain, StringFormat='{}{0:F0}%'}" 
                                       Style="{StaticResource MaterialDesignBody2TextBlock}"
                                       VerticalAlignment="Center"
                                       MinWidth="40"
                                       TextAlignment="Right"
                                       Foreground="#E0E0E0"
                                       Margin="16,0,0,0"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Right Wave 컨트롤 -->
                    <Border Margin="8,0,8,8"
                        CornerRadius="20"
                        Background="#1A1A2E">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Grid.Column="0"
                                                     Kind="HeadphonesSettings"
                                                     Width="20"
                                                     Height="20"
                                                     Foreground="{DynamicResource SecondaryHueMidBrush}"
                                                     Opacity="0.6"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0"/>

                                <TextBlock Grid.Column="1"
                                       Text="RIGHT CHANNEL" 
                                       Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                       FontWeight="Medium"
                                       Foreground="#E0E0E0"
                                       VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" 
                                    Command="{Binding DecreaseRightFrequencyCommand}"
                                    ToolTip="Decrease frequency"
                                    Width="32"
                                    Height="32"
                                    Margin="8"
                                    Background="Transparent"
                                    BorderBrush="#6C63FF"
                                    BorderThickness="2"
                                    materialDesign:ButtonAssist.CornerRadius="18">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="18">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <materialDesign:PackIcon Kind="Minus" Width="20" Height="20" Foreground="White"/>
                                </Button>

                                <Border Grid.Column="1" 
                                    CornerRadius="12"
                                    Padding="24,12"
                                    Margin="8"
                                    Background="#6C63FF">
                                    <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding RightFrequency, StringFormat='{}{0:F2}'}" 
                                               Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                                               HorizontalAlignment="Center"
                                               Foreground="White"
                                               FontWeight="Medium"/>
                                        <TextBlock Text="Hz" 
                                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                               HorizontalAlignment="Center"
                                               Foreground="White"
                                               Opacity="0.8"/>
                                    </StackPanel>
                                </Border>

                                <Button Grid.Column="2" 
                                    Command="{Binding IncreaseRightFrequencyCommand}"
                                    ToolTip="Increase frequency"
                                    Width="32"
                                    Height="32"
                                    Margin="8"
                                    Background="Transparent"
                                    BorderBrush="#6C63FF"
                                    BorderThickness="2"
                                    materialDesign:ButtonAssist.CornerRadius="18">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="18">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" Foreground="White"/>
                                </Button>
                            </Grid>

                            <Slider Grid.Row="2"
                                Value="{Binding RightFrequency, Mode=TwoWay}" 
                                Minimum="20"
                                Maximum="500"
                                TickFrequency="10"
                                IsSnapToTickEnabled="True"
                                TickPlacement="None"
                                Margin="0,0,0,8"
                                Foreground="#6C63FF"
                                materialDesign:SliderAssist.OnlyShowFocusVisualWhileDragging="True"/>

                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Grid.Column="0" 
                                                     Kind="VolumeHigh" 
                                                     VerticalAlignment="Center"
                                                     Foreground="#E0E0E0"
                                                     Opacity="0.8"
                                                     Margin="0,0,16,0"/>

                                <Slider Grid.Column="1" 
                                    Value="{Binding RightGain, Mode=TwoWay}" 
                                    Maximum="100"
                                    VerticalAlignment="Center"
                                    Foreground="#6C63FF"/>

                                <TextBlock Grid.Column="2" 
                                       Text="{Binding RightGain, StringFormat='{}{0:F0}%'}" 
                                       Style="{StaticResource MaterialDesignBody2TextBlock}"
                                       VerticalAlignment="Center"
                                       MinWidth="40"
                                       TextAlignment="Right"
                                       Foreground="#E0E0E0"
                                       Margin="16,0,0,0"/>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 컨트롤 버튼 -->
                <Grid Grid.Row="2" Margin="12,8,12,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" 
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#6C63FF"
                        BorderBrush="#6C63FF"
                        Foreground="White"
                        Command="{Binding TogglePlayCommand}"
                        Height="56"
                        materialDesign:ButtonAssist.CornerRadius="28"
                        materialDesign:ElevationAssist.Elevation="Dp4">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="{Binding PlayButtonIcon}" 
                                                 Width="24" 
                                                 Height="24"
                                                 VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PlayButtonText}" 
                                   Margin="12,0,8,0"
                                   FontSize="16"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" 
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        BorderBrush="#6C63FF"
                        Foreground="#6C63FF"
                        Command="{Binding ShowTimerCommand}"
                        Height="48"
                        materialDesign:ButtonAssist.CornerRadius="24">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Timer" 
                                                 Width="20" 
                                                 Height="20"
                                                 VerticalAlignment="Center"/>
                            <TextBlock Text="Timer" 
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>