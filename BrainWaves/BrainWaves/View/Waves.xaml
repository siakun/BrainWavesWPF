<!--
수동 주파수 제어 페이지.
위에서부터 지금 들리는 비트와 그 대역, 전체 음량, 좌우 채널을 놓는다. 좌우 채널 카드를 나란히 두어
어느 귀에 어떤 소리가 가는지 화면 배치 그대로 읽히게 한다.
-->
<Page x:Class="BrainWaves.View.Waves"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:BrainWaves.ViewModel"
      xmlns:views="clr-namespace:BrainWaves.View"
      mc:Ignorable="d"
      d:DesignHeight="650" d:DesignWidth="450"
      Title="Waves">
    <Page.DataContext>
        <vm:WavesViewModel/>
    </Page.DataContext>

    <Page.Resources>
        <!--
        헤더 파형이 흐르는 방식.
        파형은 한 주기짜리 타일을 반복해 채우고, 재생 중에는 그 타일 브러시를 한 주기만큼
        왼쪽으로 미는 동작을 되풀이한다. 타일이 끝없이 이어지므로 창을 넓혀도 오른쪽이 비지 않고,
        한 주기를 다 민 자리는 출발한 자리와 모양이 같아 이음매가 드러나지 않는다.
        멈출 때는 남은 주기를 마저 밀어 세운다. 그래야 멈추는 순간 파형이 제자리로 튀지 않고,
        다시 재생할 때도 이어서 흐르는 것처럼 보인다.
        브러시는 Rectangle이 아니라 Style의 Setter에 둔다. 재생 중에 이 페이지가 새로 만들어지면
        Style을 붙이는 순간 트리거가 곧바로 발동하는데, 요소에 직접 적은 Fill은 Style 특성보다
        나중에 설정되므로 그 시점에는 아직 없다. 애니메이션이 브러시를 찾지 못해 예외가 난다.
        Setter로 심은 값은 트리거가 도는 시점에 이미 자리를 잡고 있고, 요소마다 별개의 인스턴스로
        만들어지므로 스타일을 나눠 써도 서로 간섭하지 않는다.

        두 겹은 좌우 채널이다. 뒤쪽 겹은 왼쪽, 앞쪽 겹은 오른쪽 채널 색으로 그린다.
        면과 선을 따로 그리는 것은 닫힌 면에 선을 그으면 타일 양 끝의 세로 변까지 그어져 이음매마다 줄이 서기 때문이다.
        Windows에서 애니메이션 표시를 끈 사용자에게는 파형을 흘리지 않는다.
        -->
        <Style x:Key="LeftWaveStyle" TargetType="Rectangle">
            <Setter Property="Fill">
                <Setter.Value>
                    <DrawingBrush TileMode="Tile" Stretch="Fill"
                                  Viewbox="0,0,400,80" ViewboxUnits="Absolute"
                                  Viewport="0,0,400,80" ViewportUnits="Absolute">
                        <DrawingBrush.Transform>
                            <TranslateTransform/>
                        </DrawingBrush.Transform>
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Geometry="M0,46 C133,12 267,80 400,46 L400,80 L0,80 Z">
                                    <GeometryDrawing.Brush>
                                        <SolidColorBrush Color="{StaticResource Color.ChannelLeft}" Opacity="0.07"/>
                                    </GeometryDrawing.Brush>
                                </GeometryDrawing>
                                <GeometryDrawing Geometry="M0,46 C133,12 267,80 400,46">
                                    <GeometryDrawing.Pen>
                                        <Pen Thickness="1.5">
                                            <Pen.Brush>
                                                <SolidColorBrush Color="{StaticResource Color.ChannelLeft}" Opacity="0.75"/>
                                            </Pen.Brush>
                                        </Pen>
                                    </GeometryDrawing.Pen>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsPlaying}" Value="True"/>
                        <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(Shape.Fill).(Brush.Transform).(TranslateTransform.X)"
                                                 From="0" To="-400" Duration="0:0:9"
                                                 RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(Shape.Fill).(Brush.Transform).(TranslateTransform.X)"
                                                 To="-400" Duration="0:0:1.2">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 앞쪽 겹은 뒤쪽보다 빠르다. 두 겹이 어긋나며 겹치는 자리가 계속 바뀌어 물결이 이는 것처럼 보인다. -->
        <Style x:Key="RightWaveStyle" TargetType="Rectangle">
            <Setter Property="Fill">
                <Setter.Value>
                    <DrawingBrush TileMode="Tile" Stretch="Fill"
                                  Viewbox="0,0,300,80" ViewboxUnits="Absolute"
                                  Viewport="0,0,300,80" ViewportUnits="Absolute">
                        <DrawingBrush.Transform>
                            <TranslateTransform/>
                        </DrawingBrush.Transform>
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Geometry="M0,40 C100,0 200,80 300,40 L300,80 L0,80 Z">
                                    <GeometryDrawing.Brush>
                                        <SolidColorBrush Color="{StaticResource Color.ChannelRight}" Opacity="0.06"/>
                                    </GeometryDrawing.Brush>
                                </GeometryDrawing>
                                <GeometryDrawing Geometry="M0,40 C100,0 200,80 300,40">
                                    <GeometryDrawing.Pen>
                                        <Pen Thickness="1.5">
                                            <Pen.Brush>
                                                <SolidColorBrush Color="{StaticResource Color.ChannelRight}" Opacity="0.75"/>
                                            </Pen.Brush>
                                        </Pen>
                                    </GeometryDrawing.Pen>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsPlaying}" Value="True"/>
                        <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(Shape.Fill).(Brush.Transform).(TranslateTransform.X)"
                                                 From="0" To="-300" Duration="0:0:5"
                                                 RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(Shape.Fill).(Brush.Transform).(TranslateTransform.X)"
                                                 To="-300" Duration="0:0:1.2">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 재생 버튼은 멈춰 있을 때 주 동작으로 채우고, 재생 중에는 테두리만 남겨 지금 상태가 버튼에서도 드러나게 한다. -->
        <Style x:Key="PlayToggleButton" TargetType="Button" BasedOn="{StaticResource Button.PrimaryRound}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.TextMuted}"/>
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Page.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource SlideIn}"/>
        </EventTrigger>
    </Page.Triggers>

    <Page.RenderTransform>
        <TranslateTransform/>
    </Page.RenderTransform>

    <Grid Background="{StaticResource Brush.Background}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!--
                지금 들리는 비트와 재생 버튼. 위에서부터 무엇의 값인지, 값, 그 값이 속한 대역 순으로 읽히고,
                재생 버튼을 그 값 옆에 두어 무엇을 틀고 멈추는지 한눈에 묶어 보이게 한다.
                -->
                <Grid Grid.Row="0" Height="200" ClipToBounds="True">
                    <!--
                    웨이브 패턴 오버레이. 주기가 다른 두 겹을 서로 다른 속도로 흘려보낸다.
                    모양, 색, 주기, 속도는 모두 위쪽 스타일에 있다. 여기서는 자리와 높이만 정한다.
                    파형 아래 면이 헤더 끝에서 잘린 듯 끊겨 보이지 않도록 아래로 갈수록 흐리게 가린다.
                    -->
                    <Grid Height="80" VerticalAlignment="Bottom">
                        <Grid.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Black" Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.OpacityMask>

                        <Rectangle Style="{StaticResource LeftWaveStyle}"/>
                        <Rectangle Style="{StaticResource RightWaveStyle}"/>
                    </Grid>

                    <Grid Margin="32,20,32,0" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Text.Label}" Text="BINAURAL BEAT"/>

                            <StackPanel Orientation="Horizontal" Margin="-3,2,0,0">
                                <TextBlock Style="{StaticResource Text.Readout}"
                                           FontSize="68"
                                           Text="{Binding Resonance, StringFormat='{}{0:F2}'}"/>
                                <TextBlock Style="{StaticResource Text.Unit}"
                                           FontSize="24"
                                           VerticalAlignment="Bottom"
                                           Margin="8,0,0,14"
                                           Text="Hz"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,-2,0,0">
                                <TextBlock Style="{StaticResource Text.Readout}"
                                           FontSize="18"
                                           FontWeight="Normal"
                                           VerticalAlignment="Center"
                                           Text="{Binding Band.Symbol}"/>
                                <TextBlock Style="{StaticResource Text.Title}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding Band.Name}"/>
                                <TextBlock Style="{StaticResource Text.Caption}"
                                           FontSize="13"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding Band.Description}"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource PlayToggleButton}"
                                VerticalAlignment="Center"
                                Margin="16,8,0,0"
                                Command="{Binding TogglePlayCommand}"
                                ToolTip="{Binding PlayButtonText}"
                                AutomationProperties.Name="{Binding PlayButtonText}">
                            <materialDesign:PackIcon Kind="{Binding PlayButtonIcon}" Width="28" Height="28">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <!-- 재생 삼각형은 무게중심이 왼쪽에 있어 정가운데에 두면 왼쪽으로 쏠려 보인다. -->
                                        <Setter Property="Margin" Value="3,0,0,0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Margin" Value="0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Button>
                    </Grid>
                </Grid>

                <StackPanel Grid.Row="1" Margin="16,4,16,20">
                    <!-- 전체 음량 -->
                    <Border Style="{StaticResource Card}" Padding="16,14,16,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                       Style="{StaticResource Text.Label}"
                                       Text="MASTER VOLUME"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Style="{StaticResource Text.Readout}"
                                       HorizontalAlignment="Right"
                                       FontSize="14"
                                       FontWeight="Normal"
                                       Text="{Binding MasterVolume, StringFormat='{}{0:F0}%'}"/>

                            <materialDesign:PackIcon Grid.Row="1" Grid.Column="0"
                                                     Kind="VolumeHigh"
                                                     Width="18" Height="18"
                                                     Margin="0,0,12,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource Brush.TextMuted}"/>
                            <Slider Grid.Row="1" Grid.Column="1"
                                    Maximum="100"
                                    Value="{Binding MasterVolume, Mode=TwoWay}"
                                    AutomationProperties.Name="Master volume"/>
                        </Grid>
                    </Border>

                    <!-- 좌우 채널 -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <views:ChannelCard Grid.Column="0"
                                           Title="LEFT"
                                           ChannelBrush="{StaticResource Brush.ChannelLeft}"
                                           Frequency="{Binding LeftFrequency}"
                                           Gain="{Binding LeftGain}"
                                           DecreaseCommand="{Binding DecreaseLeftFrequencyCommand}"
                                           IncreaseCommand="{Binding IncreaseLeftFrequencyCommand}"/>

                        <views:ChannelCard Grid.Column="2"
                                           Title="RIGHT"
                                           ChannelBrush="{StaticResource Brush.ChannelRight}"
                                           Frequency="{Binding RightFrequency}"
                                           Gain="{Binding RightGain}"
                                           DecreaseCommand="{Binding DecreaseRightFrequencyCommand}"
                                           IncreaseCommand="{Binding IncreaseRightFrequencyCommand}"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
